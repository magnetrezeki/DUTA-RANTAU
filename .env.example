# Server-only database connection; use a staging-only value.
APP_DATABASE_URL=postgresql://duta_app:replace_me@127.0.0.1:5432/duta_rantau

# Browser-safe Supabase configuration. These are publishable values, not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# DUTA AI is disabled unless explicitly set to true on the server.
DUTA_AI_ENABLED=false

# Server-only provider configuration. Set only the provider selected by the
# server-side model class; never use NEXT_PUBLIC_ names for these credentials.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional NVIDIA benchmark/voice integration. It is not a chat-route fallback.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
NVIDIA_ASR_MODEL=
NVIDIA_ASR_BASE_URL=

# Optional server-only Supabase administration path; not needed for normal auth.
SUPABASE_SECRET_KEY=